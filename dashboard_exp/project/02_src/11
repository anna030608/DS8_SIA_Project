# 이벤트별 TP 여부 판단 (기간 내 TP 날짜가 하나라도 있으면 TP)
BUFFER = 1
def is_tp(start, end):
    s = pd.Timestamp(start) - pd.Timedelta(days=BUFFER)
    e = pd.Timestamp(end)   + pd.Timedelta(days=BUFFER)
    cur = s
    while cur <= e:
        if cur.strftime('%Y-%m-%d') in TP_DATES:
            return True
        cur += pd.Timedelta(days=1)
    return False

# x 좌표: 이벤트 시작일 기준
def date_to_x(date_str):
    dt = pd.Timestamp(date_str)
    return dt.year + (dt.month - 1) / 12 + (dt.day - 1) / 365

